rules_version = '2';

// Who may see and change what in Tab's database.
// - The "circle" is everyone who has joined through an invite link (members/{uid}).
//   Circle members share the list of people (names and avatars).
// - A group, its bills, payments and chat are visible only to the accounts in
//   that group's memberUids.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function inCircle() { return signedIn() && exists(/databases/$(database)/documents/members/$(me())); }
    function inGroup(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)) && me() in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }
    function liveInvite(code) {
      return code is string && code.size() >= 20 && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.expiresAt > request.time;
    }

    match /groups/{gid} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function isMember() { return me() in before().memberUids; }
      // Anything a member edits, as long as who has access stays the same.
      function memberEdit() { return isMember() && after().memberUids == before().memberUids; }
      // The owner may let people in or out, but can't lock themselves out.
      function ownerEdit() { return before().ownerUid == me() && after().memberUids is list && me() in after().memberUids; }
      function leaving() { return isMember() && after().memberUids == before().memberUids.removeAll([me()]); }
      // Someone with this group's invite link adds themself, and nothing else.
      function joining() {
        return !isMember()
          && after().diff(before()).affectedKeys().hasOnly(['memberUids', 'joinCode'])
          && after().memberUids == before().memberUids.concat([me()])
          && liveInvite(after().joinCode)
          && get(/databases/$(database)/documents/invites/$(after().joinCode)).data.groupId == gid;
      }

      allow read: if signedIn() && me() in resource.data.memberUids;
      allow create: if inCircle()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()];
      allow update: if signedIn()
        && after().ownerUid == before().ownerUid
        && (memberEdit() || ownerEdit() || leaving() || joining());
      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /bills/{id} {
        allow read, delete: if inGroup(gid);
        allow create, update: if inGroup(gid) && request.resource.data.groupId == gid;
      }
      match /payments/{id} {
        allow read, delete: if inGroup(gid);
        allow create, update: if inGroup(gid) && request.resource.data.groupId == gid;
      }
      match /messages/{id} {
        allow read, delete: if inGroup(gid);
        allow create, update: if inGroup(gid)
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
    }

    match /people/{pid} {
      allow read, delete: if inCircle();
      // An account may only link a person to itself.
      allow create: if inCircle()
        && (!('uid' in request.resource.data) || request.resource.data.uid == me());
      allow update: if inCircle()
        && (request.resource.data.get('uid', null) == resource.data.get('uid', null)
          || request.resource.data.get('uid', null) == me());
    }

    match /members/{uid} {
      allow get: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['invite', 'personId', 'joinedAt'])
        && liveInvite(request.resource.data.invite);
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personId']);
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.uid == me();
      allow create: if code.size() >= 20
        && request.resource.data.uid == me()
        && request.resource.data.groupId is string
        && inGroup(request.resource.data.groupId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'd');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /settings/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /photos/{id} {
      allow read: if inCircle();
      allow create: if inCircle()
        && request.resource.data.uid == me()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 300000;
      allow delete: if inCircle() && resource.data.uid == me();
    }
  }
}
