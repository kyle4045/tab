rules_version = '2';

// Who may see and change what in Tab's database.
// - Tab is invite-only. The "circle" is everyone let in through someone's
//   friend link (friendCodes/{code}) or a group invite link (invites/{code}),
//   each with a members/{uid} record. Circle members can read each other's
//   profiles (people/{uid}: name and avatar).
// - Every person is an account: a profile's id is its owner's uid, and only
//   the owner can change it.
// - Friends: a request (friendRequests/{from}_{to}) that the other person
//   accepts by creating friends/{a}_{b} (the two uids sorted).
// - A group, and its bills, payments and messages, is visible only to the
//   accounts in its memberUids. memberIds always lists the same accounts.
//   Nobody is put in a group by someone else: they join themselves, through
//   an invitation (groups/{gid}/invitations/{uid}) sent by a member who is
//   their friend, or through a group invite link.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function inCircle() { return signedIn() && exists(/databases/$(database)/documents/members/$(me())); }
    function inGroup(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)) && me() in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }
    function liveInvite(code) {
      return code is string && code.size() >= 20 && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.expiresAt > request.time;
    }
    function friendCode(code) {
      return code is string && code.size() >= 20 && exists(/databases/$(database)/documents/friendCodes/$(code));
    }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendsWith(uid) { return exists(/databases/$(database)/documents/friends/$(pairId(me(), uid))); }

    match /groups/{gid} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function isMember() { return me() in before().memberUids; }
      function sameLists() { return after().memberIds == after().memberUids; }
      // Anything a member edits, as long as who is in it stays the same.
      function memberEdit() { return isMember() && after().memberUids == before().memberUids; }
      // The owner may take people out, but not put anyone in or lock themself out.
      function ownerEdit() {
        return before().ownerUid == me() && me() in after().memberUids
          && after().memberUids.toSet().difference(before().memberUids.toSet()).size() == 0;
      }
      function leaving() { return isMember() && after().memberUids == before().memberUids.removeAll([me()]); }
      // Someone with an invitation or this group's invite link adds themself, and nothing else.
      function joining() {
        return !isMember()
          && after().diff(before()).affectedKeys().hasOnly(['memberUids', 'memberIds', 'joinCode'])
          && after().memberUids == before().memberUids.concat([me()])
          && (exists(/databases/$(database)/documents/groups/$(gid)/invitations/$(me()))
            || (liveInvite(after().joinCode) && get(/databases/$(database)/documents/invites/$(after().joinCode)).data.groupId == gid));
      }

      allow read: if signedIn() && me() in resource.data.memberUids;
      allow create: if inCircle()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()]
        && sameLists();
      allow update: if signedIn()
        && after().ownerUid == before().ownerUid
        && sameLists()
        && (memberEdit() || ownerEdit() || leaving() || joining());
      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /bills/{id} {
        allow read, delete: if inGroup(gid);
        allow create, update: if inGroup(gid) && request.resource.data.groupId == gid;
      }
      match /payments/{id} {
        allow read, delete: if inGroup(gid);
        allow create, update: if inGroup(gid) && request.resource.data.groupId == gid;
      }
      match /messages/{id} {
        allow read, delete: if inGroup(gid);
        allow create, update: if inGroup(gid)
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
      // An invitation to this group for one account, from a member who is their friend.
      match /invitations/{uid} {
        allow read: if inGroup(gid) || (signedIn() && me() == uid);
        allow create: if inGroup(gid)
          && friendsWith(uid)
          && !(uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids)
          && request.resource.data.from == me()
          && request.resource.data.to == uid
          && request.resource.data.groupId == gid
          && request.resource.data.groupName is string;
        // Cancelled by a member, or declined or used up by the person invited.
        allow delete: if inGroup(gid) || (signedIn() && me() == uid);
      }
    }

    // The invitations waiting for this account, across all groups.
    match /{path=**}/invitations/{uid} {
      allow read: if signedIn() && resource.data.to == me();
    }

    match /people/{uid} {
      allow read: if inCircle();
      allow create: if inCircle() && uid == me() && request.resource.data.uid == me();
      allow update: if signedIn() && uid == me() && request.resource.data.uid == me();
    }

    match /members/{uid} {
      allow get: if signedIn() && me() == uid;
      // Let in through a group invite link or someone's friend link.
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['invite', 'joinedAt', 'friendCode'])
        && (liveInvite(request.resource.data.invite) || friendCode(request.resource.data.invite));
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendCode']);
    }

    // A personal friend link: whoever opens it can send its owner a friend request.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if inCircle() && code.size() >= 20
        && request.resource.data.uid == me() && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if inCircle()
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && !friendsWith(request.resource.data.to);
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    match /friends/{id} {
      function other(uids) { return uids[0] == me() ? uids[1] : uids[0]; }
      allow read: if signedIn() && me() in resource.data.uids;
      // Accepting: only the person a request was sent to makes the friendship.
      allow create: if signedIn()
        && request.resource.data.uids is list && request.resource.data.uids.size() == 2
        && me() in request.resource.data.uids
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && id == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && exists(/databases/$(database)/documents/friendRequests/$(other(request.resource.data.uids) + '_' + me()));
      allow delete: if signedIn() && me() in resource.data.uids;
    }

    // Private messages between two friends: dms/{a_b}/messages, a < b. Only the
    // two of them read it; either may send while they are friends, as themself.
    // Either may delete (the oldest are pruned past 200, like group chat).
    match /dms/{pair}/messages/{id} {
      function uids() { return pair.split('_'); }
      function mine() { return signedIn() && uids().size() == 2 && me() in uids(); }
      allow read, delete: if mine();
      allow create: if mine()
        && uids()[0] < uids()[1]
        && friendsWith(uids()[0] == me() ? uids()[1] : uids()[0])
        && request.resource.data.keys().hasOnly(['personId', 'text', 'at'])
        && request.resource.data.personId == me()
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.uid == me();
      allow create: if code.size() >= 20
        && request.resource.data.uid == me()
        && request.resource.data.groupId is string
        && inGroup(request.resource.data.groupId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'd');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /settings/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /photos/{id} {
      allow read: if inCircle();
      allow create: if inCircle()
        && request.resource.data.uid == me()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 300000;
      allow delete: if inCircle() && resource.data.uid == me();
    }
  }
}
